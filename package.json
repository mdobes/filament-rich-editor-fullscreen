{
    "private": true,
    "type": "module",
    "scripts": {
        "dev:styles": "npx @tailwindcss/cli -i resources/css/index.css -o resources/dist/rich-editor-fullscreen.css --watch",
        "dev:scripts": "node bin/build.js --dev",
        "build:styles": "npx @tailwindcss/cli -i resources/css/index.css -o resources/dist/rich-editor-fullscreen.css --minify && npm run purge",
        "build:scripts": "node bin/build.js",
        "purge": "filament-purge -i resources/dist/rich-editor-fullscreen.css -o resources/dist/rich-editor-fullscreen.css -v 3.x",
        "dev": "npm-run-all --parallel dev:*",
        "build": "npm-run-all build:*",
        "test": "vitest run"
    },
    "devDependencies": {
        "@awcodes/filament-plugin-purge": "^1.1.1",
        "@tailwindcss/cli": "^4.3.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@tiptap/core": "^2.27.2",
        "@tiptap/extension-document": "^2.1.0",
        "@tiptap/extension-paragraph": "^2.1.0",
        "@tiptap/extension-text": "^2.1.0",
        "@tiptap/pm": "^2.27.2",
        "esbuild": "^0.28.2",
        "jsdom": "^30.0.1",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.1.13",
        "tailwindcss": "^4.3.2",
        "vitest": "^4.1.10"
    }
}
